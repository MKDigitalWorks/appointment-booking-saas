{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "playwright-report/",
    "test-results/",
    "blob-report/",
    "dist/",
    "coverage/",
    "app/(marketing)/**"
  ],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
      "rules": {}
    },
    {
      "files": ["tests/**/*", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "@next/next/no-html-link-for-pages": "off"
      }
    }
  ]
}
